# PIN bảo vệ trang /admin. Bắt buộc tối thiểu 6 ký tự.
ADMIN_PIN=123456

# Tùy chọn: giới hạn upload theo MB (mặc định 100).
MAX_UPLOAD_MB=100

# Production trên Vercel: tạo Public Blob store và kết nối với project.
# Vercel tự thêm BLOB_STORE_ID và cấp VERCEL_OIDC_TOKEN tại runtime.
# Upload trực tiếp dùng presigned URL cùng BLOB_WEBHOOK_PUBLIC_KEY; không cần
# tự tạo BLOB_READ_WRITE_TOKEN. Token tĩnh chỉ là phương án dự phòng khi chạy ngoài Vercel.

# Tùy chọn cho host khác có persistent volume. UPLOAD_DIR phải được mount/serve
# tương ứng với URL /uploads của website.
# CONTENT_DATA_PATH=/data/site-content.json
# UPLOAD_DIR=/data/uploads
